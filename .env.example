# Environment variables for Railway deployment
# Copy this file to .env.local and fill in your values

# Database Configuration
VITE_DATABASE_TYPE=supabase
# VITE_DATABASE_TYPE=sqlite

# Supabase Configuration (if using Supabase)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth (optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# App Configuration
VITE_APP_NAME="Algeria Ride Share"
VITE_APP_URL=https://your-app.railway.app

# Railway will automatically set PORT variable
# PORT is handled automatically by Railway